\BLOCK{for e in exercices}%

% ------------------------------------------------------------------------------
% Durée
% ------------------------------------------------------------------------------

\BLOCK{set d_raw = ((e.metadonnees.duree_estimee|default('0')) if e.metadonnees else '0')}%

\BLOCK{set s = d_raw|string|lower|replace(' ','')|replace('min','')|replace('mn','')}%

\BLOCK{if 'h' in s}%

\BLOCK{set p = s.split('h')}%

\BLOCK{set m = (p[0]|int) * 60 + (p[1]|int)}%

\BLOCK{else}%

\BLOCK{set m = s|int}%

\BLOCK{endif}%

% ------------------------------------------------------------------------------
% Statistiques globales
% ------------------------------------------------------------------------------

\BLOCK{set ns.tot = ns.tot + m}%

\BLOCK{if not e.facultatif}%

\BLOCK{set ns.ess = ns.ess + m}%

\BLOCK{else}%

\BLOCK{set ns.nfac = ns.nfac + 1}%

\BLOCK{endif}%

% ------------------------------------------------------------------------------
% Priorité
% ------------------------------------------------------------------------------

\BLOCK{set priorite = ((e.metadonnees.priorite|default(1))|int) if e.metadonnees else 1}%

% Sécurité : priorité entre 1 et max_priorite
\BLOCK{if priorite < 1}%
\BLOCK{set priorite = 1}%
\BLOCK{endif}%

\BLOCK{if priorite > max_priorite}%
\BLOCK{set priorite = max_priorite}%
\BLOCK{endif}%

% ------------------------------------------------------------------------------
% Difficulté
% ------------------------------------------------------------------------------

\BLOCK{set difficulte = ((e.metadonnees.difficulte|default(1))|int) if e.metadonnees else 1}%

% Sécurité : difficulté entre 1 et max_difficulte
\BLOCK{if difficulte < 1}%
\BLOCK{set difficulte = 1}%
\BLOCK{endif}%

\BLOCK{if difficulte > max_difficulte}%
\BLOCK{set difficulte = max_difficulte}%
\BLOCK{endif}%

% ------------------------------------------------------------------------------
% Nombre d'horloges
% ------------------------------------------------------------------------------

\BLOCK{set nh = ((m + intervalle_horloge - 1) // intervalle_horloge)}%

% ------------------------------------------------------------------------------
% Ligne du tableau
% ------------------------------------------------------------------------------

\VAR{e.numero|default(loop.index)}
&
\hyperref[\VAR{e.id}]{\VAR{e.intitule}}
&
\VAR{(e.metadonnees.type_exercice|default('')) if e.metadonnees else ''}
&
%
% Difficulté
%
\BLOCK{for k in range(difficulte)}%
$\star$%
\BLOCK{endfor}%
&
%
% Priorité
%
\BLOCK{for k in range(priorite)}%
\logoPriorite
\BLOCK{endfor}%
&
%
% Durée
%
\BLOCK{for i in range(nh)}%
\logoHorloge
\BLOCK{endfor}%
&
%
% Statut
%
\BLOCK{if e.metadonnees and e.metadonnees.statut is defined}%

    \BLOCK{if e.metadonnees.statut == 'facultatif'}%
        \logoFacultatif\ facultatif%
    \BLOCK{else}%
        \logoEssentiel\ \textbf{essentiel}%
    \BLOCK{endif}%

\BLOCK{else}%

    % Compatibilité avec les anciens YAML
    \BLOCK{if e.facultatif}%
        \logoFacultatif\ facultatif%
    \BLOCK{else}%
        \logoEssentiel\ \textbf{essentiel}%
    \BLOCK{endif}%

\BLOCK{endif}\\

