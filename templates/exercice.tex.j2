\BLOCK{macro render_figure(obj, in_box=false)}
    \BLOCK{if opts.show_figure and obj.figure}
        \BLOCK{set fig_list = [obj.figure] if obj.figure is mapping else obj.figure}
        \BLOCK{for fig in fig_list}
            \BLOCK{if in_box}
                \begin{center}
                    \nopagebreak
                    \BLOCK{if fig.scale}
                        \scalebox{\VAR{fig.scale}}{
                            \input{\VAR{"figures/tikz/" + fig.ref + ".tex"}}
                        }
                    \BLOCK{elif fig.width or fig.height}
                        \resizebox{\BLOCK{if fig.width}\VAR{fig.width|texdim_w}\BLOCK{else}!\BLOCK{endif}}{\BLOCK{if fig.height}\VAR{fig.height|texdim_h}\BLOCK{else}!\BLOCK{endif}}{
                            \input{\VAR{"figures/tikz/" + fig.ref + ".tex"}}
                        }
                    \BLOCK{else}
                        \input{\VAR{"figures/tikz/" + fig.ref + ".tex"}}
                    \BLOCK{endif}
                    \BLOCK{if fig.legende}
                        \captionof{figure}{\VAR{fig.legende}}
                        \BLOCK{if fig.label}\label{\VAR{fig.label}}\BLOCK{endif}
                    \BLOCK{endif}
                \end{center}
            \BLOCK{else}
                \begin{figure}[h!]
                    \centering
                    \BLOCK{if fig.scale}
                        \scalebox{\VAR{fig.scale}}{
                            \input{\VAR{"figures/tikz/" + fig.ref + ".tex"}}
                        }
                    \BLOCK{elif fig.width or fig.height}
                        \resizebox{\BLOCK{if fig.width}\VAR{fig.width|texdim_w}\BLOCK{else}!\BLOCK{endif}}{\BLOCK{if fig.height}\VAR{fig.height|texdim_h}\BLOCK{else}!\BLOCK{endif}}{
                            \input{\VAR{"figures/tikz/" + fig.ref + ".tex"}}
                        }
                    \BLOCK{else}
                        \input{\VAR{"figures/tikz/" + fig.ref + ".tex"}}
                    \BLOCK{endif}
                    \BLOCK{if fig.legende}
                        \caption{\VAR{fig.legende}}
                        \BLOCK{if fig.label}\label{\VAR{fig.label}}\BLOCK{endif}
                    \BLOCK{endif}
                \end{figure}
            \BLOCK{endif}
        \BLOCK{endfor}
    \BLOCK{endif}
\BLOCK{endmacro}

\BLOCK{macro render_animation(q)}
    \BLOCK{if opts.show_animation_note and q.animation}
        \BLOCK{set anim_list = [q.animation] if q.animation is mapping else q.animation}
        \BLOCK{for anim in anim_list}
            \par\smallskip\textit{(Animation disponible : \texttt{\VAR{anim.ref|texid}})}
        \BLOCK{endfor}
    \BLOCK{endif}
\BLOCK{endmacro}

%{# ============================================================================== #}
%{# MACRO INTERNE : Rend le contenu d'un objet (titre, texte, cours, figure, anim)  #}
%{# ============================================================================== #}
\BLOCK{macro render_block_list(item, env_name, header_title="")}
    \begin{\VAR{env_name}}\BLOCK{if header_title}[\VAR{header_title}]\BLOCK{endif}
        \VAR{item.texte if item.texte is defined else item}

        \BLOCK{if item.cours_rattache}
            \par\smallskip\textit{\small Cours rattaché : \VAR{item.cours_rattache|join(", ")}}
        \BLOCK{endif}

        \VAR{render_figure(item, in_box=true)}
        \VAR{render_animation(item)}
    \end{\VAR{env_name}}
\BLOCK{endmacro}

%{# ============================================================================== #}
%{# MACRO GÉNÉRIQUE : Gère l'affichage universel des encadrés (CDP, Cor, Sol, APL) #}
%{# ============================================================================== #}
\BLOCK{macro render_section(show_flag, data, env_name, is_apl=false)}
    \BLOCK{if show_flag and data}
        \BLOCK{if data is string}
            %{# Format simple : chaîne de caractères brute #}
            \begin{\VAR{env_name}}
                \VAR{data}
            \end{\VAR{env_name}}
        \BLOCK{elif is_apl and data is mapping}
            %{# "Aller plus loin" Ancien format : dictionnaire {niveau: texte} #}
            \BLOCK{for niveau in show_flag}
                \BLOCK{if niveau in data}
                    \begin{\VAR{env_name}}[\VAR{niveau_label(niveau)}]
                        \VAR{data[niveau]}
                    \end{\VAR{env_name}}
                \BLOCK{endif}
            \BLOCK{endfor}
        \BLOCK{else}
            %{# Nouveau format : Liste d'objets structurés #}
            \BLOCK{for item in data}
                \BLOCK{if is_apl}
                    %{# Traitement spécifique pour "Aller plus loin" avec filtre par niveau #}
                    \BLOCK{if item.niveau in show_flag}
                        \BLOCK{set title = niveau_label(item.niveau) + (' -- ' + item.titre if item.titre else '')}
                        \VAR{render_block_list(item, env_name, header_title=title)}
                    \BLOCK{endif}
                \BLOCK{else}
                    %{# Traitement standard (Coup de pouce, Correction, Solution) #}
                    \VAR{render_block_list(item, env_name, header_title=item.titre|default(""))}
                \BLOCK{endif}
            \BLOCK{endfor}
        \BLOCK{endif}
    \BLOCK{endif}
\BLOCK{endmacro}

%{# ============================================================================== #}
%{# MACROS : accroche / outils mathématiques / liens autres disciplines             #}
%{# Champs YAML spécifiques (différents de titre/texte) :                           #}
%{#   accroche_point_cours_essentiel : titre, duree_introduction,                  #}
%{#                                    question_d_accroche, texte                  #}
%{#   outils_mathematiques           : titre, texte                                #}
%{#   liens_autres_disciplines       : discipline, texte                           #}
%{# ============================================================================== #}
\BLOCK{macro render_accroche(show_flag, data, show_duree=true)}
    \BLOCK{if show_flag and data}
        \BLOCK{for item in data}
            \begin{accrochecours}\BLOCK{if item.titre}[\VAR{item.titre}]\BLOCK{endif}
                \BLOCK{if show_duree and item.duree_introduction}
                    {\small\itshape\color{grayBrume}Durée de l'introduction : \VAR{item.duree_introduction}\par}
                    \smallskip
                \BLOCK{endif}
                \BLOCK{if item.question_d_accroche}
                    \textbf{\textsf{Question d'accroche.}}\par\smallskip
                    {\itshape \VAR{item.question_d_accroche}\par}
                    \medskip
                \BLOCK{endif}
                \VAR{item.texte if item.texte is defined else item}
            \end{accrochecours}
        \BLOCK{endfor}
    \BLOCK{endif}
\BLOCK{endmacro}

\BLOCK{macro render_outils_maths(show_flag, data)}
    \BLOCK{if show_flag and data}
        \begin{outilsmathematiques}
            \begin{itemize}\setlength{\itemsep}{4pt}
            \BLOCK{for item in data}
                \item \BLOCK{if item.titre}\textbf{\VAR{item.titre}}\par\BLOCK{endif}
                    \VAR{item.texte if item.texte is defined else item}
            \BLOCK{endfor}
            \end{itemize}
        \end{outilsmathematiques}
    \BLOCK{endif}
\BLOCK{endmacro}

\BLOCK{macro render_liens_disciplines(show_flag, data)}
    \BLOCK{if show_flag and data}
        \begin{liensautresdisciplines}
            \begin{itemize}\setlength{\itemsep}{4pt}
            \BLOCK{for item in data}
                \item \BLOCK{if item.discipline}\textbf{\VAR{item.discipline}}\ --- \ \BLOCK{endif}\VAR{item.texte if item.texte is defined else item}
            \BLOCK{endfor}
            \end{itemize}
        \end{liensautresdisciplines}
    \BLOCK{endif}
\BLOCK{endmacro}

%{# ============================================================================== #}
%{# MACRO : titre de partie au niveau TD (utilisé uniquement en phase 'fin')         #}
%{# ============================================================================== #}
\BLOCK{macro render_titre_td(txt)}
    \par\medskip\noindent{\large\bfseries\sffamily \VAR{txt}}\par\nopagebreak\smallskip
\BLOCK{endmacro}

%{# ============================================================================== #}
%{# MACRO QUESTION PRINCIPALE                                                       #}
%{# ============================================================================== #}
\BLOCK{macro render_question(q)}
    \VAR{q.enonce}

    %{# --- FIGURES ET ANIMATIONS --- #}
    \VAR{render_figure(q)}
    \VAR{render_animation(q)}

    %{# --- ENCADRÉS STRUCTURÉS (Factorisés via render_section) --- #}
    \VAR{render_section(opts.show_prerequis, q.prerequis, 'prerequis')}
    \VAR{render_section(opts.show_objectifs_pedagogiques_etudiants, q.objectifs_pedagogiques_etudiants, 'objectifspedagogiquesetudiants')}
    \VAR{render_section(opts.show_objectifs_pedagogiques_enseignants, q.objectifs_pedagogiques_enseignants, 'objectifspedagogiquesenseignants')}
    \VAR{render_section(opts.show_point_cours, q.point_cours, 'pointcours')}
    \VAR{render_section(opts.show_coup_de_pouce, q.coup_de_pouce, 'coupdepouce')}
    \VAR{render_section(opts.show_attention, q.attention, 'attention')}
    \VAR{render_section(opts.show_correction, q.correction, 'correction')}
    \VAR{render_section(opts.show_solution, q.solution, 'solutiondetaillee')}
    \VAR{render_section(opts.show_remarques_pedagogiques_ecueils_classiques, q.remarques_pedagogiques_ecueils_classiques, 'remarquespedagogiquesecueilsclassiques')}
    \VAR{render_section(opts.show_remarques_pedagogiques_conseils_animation, q.remarques_pedagogiques_conseils_animation, 'remarquespedagogiquesconseilsanimation')}
    \VAR{render_section(opts.show_bilan, q.bilan, 'bilan')}
    \VAR{render_section(opts.aller_plus_loin_niveaux, q.aller_plus_loin, 'allerplusloin', is_apl=true)}

    %{# --- ENCADRÉ GÉNÉRIQUE DATA-DRIVEN --- #}
    \BLOCK{if q.encadre}
        \EncadreDeux{\VAR{q.encadre.type}}{\VAR{q.encadre.titre}}{\VAR{q.encadre.couleur}}{\VAR{q.encadre.contenu}}
    \BLOCK{endif}

    %{# --- OVERLAY TIKZ AU NIVEAU QUESTION --- #}
    \BLOCK{if q.overlay_tikz and opts.show_solution}
        \begin{tikzpicture}[remember picture, overlay]
            \VAR{q.overlay_tikz}
        \end{tikzpicture}
    \BLOCK{endif}
\BLOCK{endmacro}

%{# ============================================================================== #}
%{# TITRE DE L'EXERCICE (niveau 1) + ancre + lien retour vers le plan de séance     #}
%{# Rendu uniquement si titre_exercice est vrai (pas pour l'ouverture/clôture du TD) #}
%{# ============================================================================== #}
\BLOCK{if titre_exercice is defined and titre_exercice}

\BLOCK{if opts.show_metadonnees and ex.metadonnees}
\TitreNiveauUn[
  \BLOCK{if ex.metadonnees.indispensable}
    indispensable=\VAR{ex.metadonnees.indispensable},
  \BLOCK{endif}
  \BLOCK{if ex.metadonnees.difficulte}
    difficulte=\VAR{ex.metadonnees.difficulte},
  \BLOCK{endif}
  \BLOCK{if ex.metadonnees.duree_estimee}
    duree={\VAR{ex.metadonnees.duree_estimee}},
  \BLOCK{endif}
  \BLOCK{if ex.metadonnees.type_exercice}
    type={\VAR{ex.metadonnees.type_exercice}}
  \BLOCK{endif}
]{Exercice \VAR{ex.numero}. \VAR{ex.intitule}\BLOCK{if ex.facultatif} \textit{(facultatif)}\BLOCK{endif}}
\BLOCK{else}
\TitreNiveauUn{Exercice \VAR{ex.numero}. \VAR{ex.intitule}\BLOCK{if ex.facultatif} \textit{(facultatif)}\BLOCK{endif}}
\BLOCK{endif}

\phantomsection
\addcontentsline{toc}{subsection}{Exercice \VAR{ex.numero}. \VAR{ex.intitule}}
\BLOCK{if ex.id}\label{\VAR{ex.id}}\BLOCK{endif}


%{# Lien retour : seulement si le plan de séance existe (cible du \label{plandelaseance}) #}
\BLOCK{if (opts.show_plan_seance is not defined or opts.show_plan_seance) and exercices is defined and exercices}
\hyperref[plandelaseance]{\large\bfseries\sffamily $\triangleleft$ Plan de la séance}
\BLOCK{endif}

\bigskip

\BLOCK{endif}


%{# ============================================================================== #}
%{# PHASES DE RENDU                                                                 #}
%{#   td_phase non défini ou 'all' : exercice complet (comportement historique)    #}
%{#   td_phase = 'debut'  : ouverture du TD (cadrage, prérequis, objectifs, cours)  #}
%{#   td_phase = 'fin'    : clôture du TD (écueils, animation, bilan, liens, APL)   #}
%{# ============================================================================== #}
\BLOCK{set _phase = td_phase if td_phase is defined else 'all'}
\BLOCK{set _head = _phase in ['all', 'debut']}
\BLOCK{set _tail = _phase in ['all', 'fin']}

\BLOCK{if _head}
%{# Accroche + point de cours essentiel : introduit en tout début d'exercice (avant l'énoncé) #}
\VAR{render_accroche(opts.show_accroche_point_cours_essentiel is not defined or opts.show_accroche_point_cours_essentiel, ex.accroche_point_cours_essentiel, opts.show_duree_introduction is not defined or opts.show_duree_introduction)}

\BLOCK{if ex.enonce_intro}
\VAR{ex.enonce_intro}
\BLOCK{endif}

\VAR{render_figure(ex)}
\VAR{render_animation(ex)}

\VAR{render_section(opts.show_prerequis, ex.prerequis, 'prerequis')}
\VAR{render_section(opts.show_objectifs_pedagogiques_etudiants, ex.objectifs_pedagogiques_etudiants, 'objectifspedagogiquesetudiants')}
\VAR{render_section(opts.show_objectifs_pedagogiques_enseignants, ex.objectifs_pedagogiques_enseignants, 'objectifspedagogiquesenseignants')}
\VAR{render_section(opts.show_point_cours, ex.point_cours, 'pointcours')}
\VAR{render_outils_maths(opts.show_outils_mathematiques is not defined or opts.show_outils_mathematiques, ex.outils_mathematiques)}
\VAR{render_section(opts.show_coup_de_pouce, ex.coup_de_pouce, 'coupdepouce')}
\VAR{render_section(opts.show_attention, ex.attention, 'attention')}
\BLOCK{endif}

\BLOCK{if _phase == 'all' and ex.questions}
\begin{enumerate}[label=\arabic*.]
\BLOCK{for item in ex.contenu}
    \BLOCK{if item.kind == 'intro'}
        \item \VAR{item.enonce}
    \BLOCK{elif item.kind == 'single'}
        \item \VAR{render_question(item)}
    \BLOCK{elif item.kind == 'group'}
        \BLOCK{if loop.previtem is defined and loop.previtem.kind == 'intro'}
            \VAR{render_question(item)}
        \BLOCK{else}
            \item \VAR{render_question(item)}
        \BLOCK{endif}
        \begin{enumerate}[label=\alph*)]
        \BLOCK{for sub in item.subquestions}
            \item \VAR{render_question(sub)}
        \BLOCK{endfor}
        \end{enumerate}
    \BLOCK{endif}
\BLOCK{endfor}
\end{enumerate}
\BLOCK{endif}

\BLOCK{if _tail}
\BLOCK{if _phase == 'fin'}
\VAR{render_titre_td(opts.titre_cloture_td if opts.titre_cloture_td is defined else "Bilan et prolongements du TD")}
\BLOCK{endif}
\VAR{render_section(opts.show_remarques_pedagogiques_ecueils_classiques, ex.remarques_pedagogiques_ecueils_classiques, 'remarquespedagogiquesecueilsclassiques')}
\VAR{render_section(opts.show_remarques_pedagogiques_conseils_animation, ex.remarques_pedagogiques_conseils_animation, 'remarquespedagogiquesconseilsanimation')}
\VAR{render_section(opts.show_bilan, ex.bilan, 'bilan')}
\VAR{render_liens_disciplines(opts.show_liens_autres_disciplines is not defined or opts.show_liens_autres_disciplines, ex.liens_autres_disciplines)}
\VAR{render_section(opts.aller_plus_loin_niveaux, ex.aller_plus_loin, 'allerplusloin', is_apl=true)}
\BLOCK{endif}

\BLOCK{if ex.overlay_tikz and opts.show_solution}
    \begin{tikzpicture}[remember picture, overlay]
        \VAR{ex.overlay_tikz}
    \end{tikzpicture}
\BLOCK{endif}
